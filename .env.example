# Copy to .env and fill locally. Never commit real values.
# PayPal developer SANDBOX app credentials (live credentials are refused by design).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. If set, must be exactly https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OpenAI-compatible model provider for the shopping agent.
AI4PG_LLM_BASE_URL=
AI4PG_LLM_API_KEY=
AI4PG_LLM_MODEL=
# Optional caps. Defaults: 25 calls, 1500 tokens.
AI4PG_LLM_MAX_CALLS=
AI4PG_LLM_MAX_TOKENS=

# Used only by scripts/live_phase2.py and scripts/fresh_order.py (Nebius Token Factory, OpenAI-compatible).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Gate settings
AI4PG_DATA_DIR=./data
AI4PG_PERMIT_TTL_SECONDS=600
AI4PG_POLICY_PATH=./policy/demo-policy.json
AI4PG_PUBLIC_BASE_URL=http://127.0.0.1:8088
PORT=8088
# Human approver secret. If unset, one is generated into $AI4PG_DATA_DIR/approver_token (mode 600).
AI4PG_APPROVER_TOKEN=
